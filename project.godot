; Adam's Summit — native, local two-player prototype
config_version=5

[application]
config/name="Adam's Summit"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A family climbing adventure for phones, tablets and TV."
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.075, 0.17, 0.18, 1)
textures/canvas_textures/default_texture_filter=2
textures/vram_compression/import_etc2_astc=true

[physics]
common/physics_ticks_per_second=60

[audio]
driver/enable_input=false
